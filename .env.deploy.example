# Copia este archivo a .env.deploy y completa los valores.
# No lo subas a git.

# Supabase → Project Settings → Database → URI (Session mode) + sslmode=require
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# Opcional: owner id de Render (si no, se detecta vía API)
# RENDER_OWNER_ID=
